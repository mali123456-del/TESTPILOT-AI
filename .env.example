# TESTPILOT AI — example configuration. Copy to .env and edit. Never commit .env.
PORT=4318
TESTPILOT_DATA_DIR=./data
# Optional AI providers. Basic functionality works fully without any provider.
AI_PROVIDER=local            # local | ollama | openai-compatible
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
# Set to 1 when running behind a trusted TLS proxy.
TRUST_PROXY=0
